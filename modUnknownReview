'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-21
' Parameters:    wksTarget As Excel.Worksheet
' Returns:       ---
' Description:   Deletes only ADD buttons generated by this tool.
'-------------------------------------------------------------------------------
Private Sub DeleteUnknownActionButtons(ByVal wksTarget As Excel.Worksheet)
    Const METHOD_NAME As String = "DeleteUnknownActionButtons"
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngShape As Long

    If Not DEV_MODE Then On Error GoTo ErrHandler

    For lngShape = wksTarget.Shapes.Count To 1 Step -1
        If InStr( _
            1, wksTarget.Shapes(lngShape).Name, _
            UNKNOWN_REVIEW_BUTTON_PREFIX, vbTextCompare) = 1 Then

            wksTarget.Shapes(lngShape).Delete
        End If
    Next lngShape

ExitPoint:
    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call ErrorManager.addError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-21
' Parameters:    Review worksheet and last transaction row.
' Returns:       ---
' Description:   Formats the internal Unknown Review table.
'-------------------------------------------------------------------------------
Private Sub FormatUnknownReviewSheet( _
    ByVal wksReview As Excel.Worksheet, _
    ByVal lngLastRow As Long)

    Const METHOD_NAME As String = "FormatUnknownReviewSheet"
    Const MAX_COLUMN_WIDTH As Double = 255
    Dim dblWidth As Double
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngColumn As Long
    Dim rngTable As Excel.Range

    If Not DEV_MODE Then On Error GoTo ErrHandler

    Set rngTable = wksReview.Range( _
        wksReview.Cells(1, 1), _
        wksReview.Cells(lngLastRow, OUTPUT_COLUMN_COUNT))

    With wksReview.Range( _
        wksReview.Cells(1, 1), _
        wksReview.Cells(1, OUTPUT_COLUMN_COUNT))

        .Font.Bold = True
        .Font.Name = OUTPUT_HEADER_FONT_NAME
        .Font.Size = OUTPUT_HEADER_FONT_SIZE
        .Font.Color = OUTPUT_HEADER_FONT_COLOR
        .Interior.Color = OUTPUT_HEADER_FILL_COLOR
        .WrapText = True
    End With

    Call rngTable.AutoFilter
    wksReview.Columns("C:D").NumberFormat = "dd.mm.yyyy"
    wksReview.Columns("H:I").NumberFormat = "dd.mm.yyyy"
    wksReview.Columns("R:S").NumberFormat = "#,##0.00"
    wksReview.Columns("V:V").NumberFormat = OUTPUT_TIMESTAMP_NUMBER_FORMAT
    wksReview.Columns("W:W").NumberFormat = "@"
    Call rngTable.Columns.AutoFit

    For lngColumn = 1 To OUTPUT_COLUMN_COUNT
        dblWidth = wksReview.Columns(lngColumn).ColumnWidth + 2
        If dblWidth > MAX_COLUMN_WIDTH Then dblWidth = MAX_COLUMN_WIDTH
        wksReview.Columns(lngColumn).ColumnWidth = dblWidth
    Next lngColumn

ExitPoint:
    Set rngTable = Nothing
    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call ErrorManager.addError( _
        CLASS_NAME, METHOD_NAME, errNumber, errDescription, _
        "lastRow", lngLastRow)
    GoTo ExitPoint
End Sub
