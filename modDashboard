Option Explicit

Private Const CLASS_NAME As String = "modDashboard"

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-26
' Parameters:    Workbook, Transactions worksheet and last transaction row.
' Returns:       ---
' Description:   Creates Team/Fund slicers above the Combined transaction table.
'-------------------------------------------------------------------------------
Public Sub EnsureCombinedDashboard( _
    ByVal wkbTarget As Excel.Workbook, _
    ByVal wksTransactions As Excel.Worksheet, _
    ByVal lngLastRow As Long)

    Const METHOD_NAME As String = "EnsureCombinedDashboard"
    Dim errDescription As String
    Dim errNumber As Long
    Dim lstTransactions As Excel.ListObject
    Dim scFund As Excel.SlicerCache
    Dim scTeam As Excel.SlicerCache
    Dim slFund As Excel.Slicer
    Dim slTeam As Excel.Slicer

    If Not DEV_MODE Then On Error GoTo ErrHandler

    If wkbTarget Is Nothing Or wksTransactions Is Nothing Then
        Call VBA.Err.Raise( _
            ERROR_OUTPUT, METHOD_NAME, _
            "Combined workbook or Transactions worksheet is not available.")
    End If

    If lngLastRow < COMBINED_TABLE_HEADER_ROW Then
        lngLastRow = COMBINED_TABLE_HEADER_ROW
    End If

    Call DeleteOwnedSlicerCaches(wkbTarget)
    Call DeleteLegacyDashboardSheet(wkbTarget)
    Call ResetCombinedFilterArea(wksTransactions)
    Set lstTransactions = EnsureTransactionsTable(wksTransactions, lngLastRow)

    Set scTeam = wkbTarget.SlicerCaches.Add2( _
        Source:=lstTransactions, SourceField:="Team")
    Set slTeam = scTeam.Slicers.Add( _
        SlicerDestination:=wksTransactions.Name, _
        Name:=SLICER_TEAM_NAME, Caption:="Team", _
        Top:=8, Left:=8, Width:=180, Height:=125)

    Set scFund = wkbTarget.SlicerCaches.Add2( _
        Source:=lstTransactions, SourceField:="MF")
    Set slFund = scFund.Slicers.Add( _
        SlicerDestination:=wksTransactions.Name, _
        Name:=SLICER_FUND_NAME, Caption:="Fund", _
        Top:=8, Left:=205, Width:=220, Height:=125)

    With slTeam
        .DisplayHeader = True
        .NumberOfColumns = 1
        .Locked = True
    End With

    With slFund
        .DisplayHeader = True
        .NumberOfColumns = 1
        .Locked = True
    End With

ExitPoint:
    Set slFund = Nothing
    Set slTeam = Nothing
    Set scFund = Nothing
    Set scTeam = Nothing
    Set lstTransactions = Nothing

    If errNumber <> 0 Then
        Call VBA.Err.Raise( _
            errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call ErrorManager.addError( _
        CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-26
' Parameters:    Transactions worksheet and last transaction row.
' Returns:       Excel.ListObject
' Description:   Creates or resizes the Combined table from row 11 downward.
'-------------------------------------------------------------------------------
Private Function EnsureTransactionsTable( _
    ByVal wksTransactions As Excel.Worksheet, _
    ByVal lngLastRow As Long) As Excel.ListObject

    Const METHOD_NAME As String = "EnsureTransactionsTable"
    Dim errDescription As String
    Dim errNumber As Long
    Dim lstCandidate As Excel.ListObject
    Dim lstResult As Excel.ListObject
    Dim rngTable As Excel.Range

    If Not DEV_MODE Then On Error GoTo ErrHandler

    Set rngTable = wksTransactions.Range( _
        wksTransactions.Cells(COMBINED_TABLE_HEADER_ROW, 1), _
        wksTransactions.Cells(lngLastRow, OUTPUT_COLUMN_COUNT))

    For Each lstCandidate In wksTransactions.ListObjects
        If StrComp( _
            lstCandidate.Name, TRANSACTIONS_TABLE_NAME, vbTextCompare) = 0 Then

            Set lstResult = lstCandidate
            Exit For
        End If
    Next lstCandidate

    If lstResult Is Nothing Then
        If wksTransactions.AutoFilterMode Then
            wksTransactions.AutoFilterMode = False
        End If

        Set lstResult = wksTransactions.ListObjects.Add( _
            xlSrcRange, rngTable, , xlYes)
        lstResult.Name = TRANSACTIONS_TABLE_NAME
    Else
        Call lstResult.Resize(rngTable)
    End If

    lstResult.ShowTableStyleRowStripes = False
    lstResult.ShowTableStyleFirstColumn = False
    lstResult.ShowTableStyleLastColumn = False

    With lstResult.HeaderRowRange
        .Font.Bold = True
        .Font.Name = OUTPUT_HEADER_FONT_NAME
        .Font.Size = OUTPUT_HEADER_FONT_SIZE
        .Font.Color = OUTPUT_HEADER_FONT_COLOR
        .Interior.Color = OUTPUT_HEADER_FILL_COLOR
        .WrapText = True
    End With

ExitPoint:
    Set lstCandidate = Nothing
    Set rngTable = Nothing
    If errNumber = 0 Then Set EnsureTransactionsTable = lstResult
    Set lstResult = Nothing

    If errNumber <> 0 Then
        Call VBA.Err.Raise( _
            errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Function

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call ErrorManager.addError( _
        CLASS_NAME, METHOD_NAME, errNumber, errDescription, _
        "lastRow", lngLastRow)
    GoTo ExitPoint
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-26
' Parameters:    wksTransactions As Excel.Worksheet
' Returns:       ---
' Description:   Clears rows reserved for Combined slicers without touching data.
'-------------------------------------------------------------------------------
Private Sub ResetCombinedFilterArea( _
    ByVal wksTransactions As Excel.Worksheet)

    Const METHOD_NAME As String = "ResetCombinedFilterArea"
    Dim errDescription As String
    Dim errNumber As Long
    Dim rngFilterArea As Excel.Range

    If Not DEV_MODE Then On Error GoTo ErrHandler

    Set rngFilterArea = wksTransactions.Range( _
        wksTransactions.Cells(1, 1), _
        wksTransactions.Cells(COMBINED_TABLE_HEADER_ROW - 1, OUTPUT_COLUMN_COUNT))

    rngFilterArea.Clear
    rngFilterArea.Font.Name = OUTPUT_HEADER_FONT_NAME
    rngFilterArea.Font.Size = OUTPUT_HEADER_FONT_SIZE

ExitPoint:
    Set rngFilterArea = Nothing
    If errNumber <> 0 Then
        Call VBA.Err.Raise( _
            errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call ErrorManager.addError( _
        CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-26
' Parameters:    wkbTarget As Excel.Workbook
' Returns:       ---
' Description:   Deletes the obsolete separate Dashboard worksheet if present.
'-------------------------------------------------------------------------------
Private Sub DeleteLegacyDashboardSheet( _
    ByVal wkbTarget As Excel.Workbook)

    Const METHOD_NAME As String = "DeleteLegacyDashboardSheet"
    Dim blnPreviousDisplayAlerts As Boolean
    Dim blnDisplayAlertsCaptured As Boolean
    Dim errDescription As String
    Dim errNumber As Long
    Dim wksCandidate As Excel.Worksheet

    If Not DEV_MODE Then On Error GoTo ErrHandler

    For Each wksCandidate In wkbTarget.Worksheets
        If StrComp( _
            wksCandidate.Name, SHEET_DASHBOARD, vbTextCompare) = 0 Then

            blnPreviousDisplayAlerts = Application.DisplayAlerts
            blnDisplayAlertsCaptured = True
            Application.DisplayAlerts = False
            wksCandidate.Delete
            Application.DisplayAlerts = blnPreviousDisplayAlerts
            Exit For
        End If
    Next wksCandidate

ExitPoint:
    If blnDisplayAlertsCaptured Then
        Application.DisplayAlerts = blnPreviousDisplayAlerts
    End If
    Set wksCandidate = Nothing

    If errNumber <> 0 Then
        Call VBA.Err.Raise( _
            errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call ErrorManager.addError( _
        CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-26
' Parameters:    wkbTarget As Excel.Workbook
' Returns:       ---
' Description:   Deletes only slicer caches owned by this Dallas report.
'-------------------------------------------------------------------------------
Private Sub DeleteOwnedSlicerCaches(ByVal wkbTarget As Excel.Workbook)
    Const METHOD_NAME As String = "DeleteOwnedSlicerCaches"
    Dim blnDeleteCache As Boolean
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim scCandidate As Excel.SlicerCache
    Dim strCacheName As String
    Dim strSourceName As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    For lngIndex = wkbTarget.SlicerCaches.Count To 1 Step -1
        Set scCandidate = wkbTarget.SlicerCaches(lngIndex)
        blnDeleteCache = False
        strCacheName = scCandidate.Name

        If StrComp( _
            strCacheName, SLICER_CACHE_TEAM_NAME, vbTextCompare) = 0 Or _
            StrComp( _
                strCacheName, SLICER_CACHE_FUND_NAME, vbTextCompare) = 0 Then

            blnDeleteCache = True
        ElseIf scCandidate.List Then
            If StrComp( _
                scCandidate.ListObject.Name, _
                TRANSACTIONS_TABLE_NAME, vbTextCompare) = 0 Then

                strSourceName = scCandidate.SourceName

                If StrComp(strSourceName, "Team", vbTextCompare) = 0 Or _
                    StrComp(strSourceName, "MF", vbTextCompare) = 0 Then

                    blnDeleteCache = True
                End If
            End If
        End If

        If blnDeleteCache Then Call scCandidate.Delete
        Set scCandidate = Nothing
    Next lngIndex

ExitPoint:
    Set scCandidate = Nothing
    If errNumber <> 0 Then
        Call VBA.Err.Raise( _
            errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call ErrorManager.addError( _
        CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub
